POSTGRES_PASSWORD=acts
APP_PORT=3710
DB_PORT=5710
DATABASE_URL=postgres://acts:acts@localhost:5710/acts
DATABASE_URL_TEST=postgres://acts:acts@localhost:5710/acts_test
ADMIN_EMAIL=admin@approid.team
# Required (>= 8 chars, not "change-me-now"). Used ONLY on the first seed; to change
# it later run `pnpm admin:reset-password <email>` (see docs/deploy.md).
ADMIN_PASSWORD=
# Local dev / e2e over plain http needs COOKIE_SECURE=false in your .env.
# Leave it unset in production: docker-compose defaults it to true.
# COOKIE_SECURE=false
# Evidence attachments directory (optional). Defaults to ./uploads (in Docker: /app/uploads,
# the `uploads` volume). Back it up along with the database — see docs/deploy.md §5.
# UPLOAD_DIR=
CLOUDFLARE_TUNNEL_TOKEN=
# Payroll (Phase 2): 32-byte key, base64. Encrypts 주민등록번호, account numbers and TOTP secrets.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes those values unreadable; back it up separately from the database.
PAYROLL_ENCRYPTION_KEY=
